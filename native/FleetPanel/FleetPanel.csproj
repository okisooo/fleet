<Project Sdk="Microsoft.NET.Sdk">

  <!-- Native flyout for Fleet. .NET Framework 4.8 ships with Windows, so the
       panel adds no runtime to install; the Python tray launches it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FleetPanel</AssemblyName>
    <RootNamespace>FleetPanel</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.0.0</Version>
    <Product>Fleet</Product>
    <Company>okisooo</Company>
    <Description>Fleet usage flyout</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <EmbeddedResource Include="Glass.ps" LogicalName="Glass.ps" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
